# syntax=docker/dockerfile:1.7
# Dev API — DuckDB sobre el CSV SECOP II 2025 (snapshot 1.7GB).
# Sirve los shapes EXACTOS que consume el dashboard Next.js.
# El CSV se monta como volumen en /tmp/ronda2/ via custom_docker_run_options.

FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir \
        "fastapi>=0.115" \
        "uvicorn[standard]>=0.32" \
        "duckdb>=1.1" \
        "pydantic>=2.9"

RUN groupadd -r api && useradd -r -g api -u 1000 api

WORKDIR /app
COPY --chown=api:api scripts/api_dev.py ./api_dev.py

USER api

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=5 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "api_dev:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "1", \
     "--proxy-headers", \
     "--forwarded-allow-ips", "*"]
