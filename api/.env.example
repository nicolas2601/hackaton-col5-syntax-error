# ─── SECOP API — Environment Variables ───
# Copiar a .env y completar valores reales.

# ── Database ──────────────────────────────────────────────────
# DSN format: postgres://postgres:<PASS>@<UUID>:5432/secop
# UUID Coolify (interno docker network): roook084kg4owsgkcc8k08s8
DATABASE_URL=postgres://postgres:CHANGEME@roook084kg4owsgkcc8k08s8:5432/secop
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_TIMEOUT=30

# ── App ───────────────────────────────────────────────────────
APP_NAME=SECOP API
APP_VERSION=0.1.0
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=https://panel.tikno.pro,http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100

# ── Cache ─────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300

# ── Snapshot metadata ─────────────────────────────────────────
DATA_SNAPSHOT_DATE=2026-05-06
DATA_TOTAL_ROWS=1003902
DATA_TOTAL_COLUMNS=84
DATA_TABLE_NAME=contratos_2025
